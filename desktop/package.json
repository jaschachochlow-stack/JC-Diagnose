{
  "name": "jc-diagnose-desktop",
  "version": "0.10.0",
  "description": "JC Diagnose für Windows",
  "main": "main.js",
  "author": "JC",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.jc.diagnose.desktop",
    "productName": "JC Diagnose",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "build/icon.png", "app/**/*"],
    "win": { "target": [{ "target": "portable", "arch": ["x64"] }], "icon": "build/icon.png" },
    "portable": { "artifactName": "JC-Diagnose-Windows.exe" }
  }
}
